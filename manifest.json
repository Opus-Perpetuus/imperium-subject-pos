{
  "$schema": "https://schemas.opus-perpetuus.dev/imperium/kirlet-manifest/1.0.json",
  "manifestVersion": 1,
  "id": "SUBJECT-pos",
  "technicalId": "subject-pos",
  "name": "POS",
  "version": "0.11.0",
  "image": "ghcr.io/opus-perpetuus/subject-pos:0.11.0",
  "compat": {
    "nox": ">=0.5.0",
    "kit": "^0.5.0"
  },
  "api": {
    "basePath": "/",
    "port": 3000,
    "healthPath": "/health"
  },
  "permissions": [
    {
      "id": "subject.pos.pos-session.read",
      "label": "Ver Sesiones POS"
    },
    {
      "id": "subject.pos.pos-session.write",
      "label": "Editar Sesiones POS"
    },
    {
      "id": "subject.pos.pos.read",
      "label": "Ver Estación POS"
    },
    {
      "id": "subject.pos.pos.write",
      "label": "Editar Estación POS"
    },
    {
      "id": "subject.pos.pos-order.read",
      "label": "Ver Ordenes"
    },
    {
      "id": "subject.pos.pos-order.write",
      "label": "Editar Ordenes"
    },
    {
      "id": "subject.pos.pos-tickets.read",
      "label": "Ver Tickets"
    },
    {
      "id": "subject.pos.pos-tickets.write",
      "label": "Editar Tickets"
    }
  ],
  "menu": [
    {
      "id": "pos.root",
      "label": "POS",
      "order": 0,
      "children": [
        {
          "id": "pos.pos-session",
          "label": "Sesiones POS",
          "pageId": "pos.pos-session",
          "order": 0,
          "path": "pos-session",
          "permission": "subject.pos.pos-session.read",
          "icon": "document"
        },
        {
          "id": "pos.pos",
          "label": "Estación POS",
          "pageId": "pos.pos",
          "order": 0,
          "path": "pos",
          "permission": "subject.pos.pos.read",
          "icon": "document"
        },
        {
          "id": "pos.pos-tickets",
          "label": "Tickets",
          "pageId": "pos.pos-tickets",
          "order": 0,
          "path": "pos-tickets",
          "permission": "subject.pos.pos-tickets.read",
          "icon": "document"
        },
        {
          "id": "pos.pos-order",
          "label": "Ordenes",
          "pageId": "pos.pos-order",
          "order": 1,
          "path": "pos-order",
          "permission": "subject.pos.pos-order.read",
          "icon": "document"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "pos.pos-session",
      "path": "pos-session",
      "permission": "subject.pos.pos-session.read",
      "leaf": {
        "kind": "crud",
        "appBase": "pos-session",
        "icon": "fa-cash-register",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "state": "Estado",
            "is_active": "Activa"
          }
        }
      }
    },
    {
      "id": "pos.pos",
      "path": "pos",
      "permission": "subject.pos.pos.read",
      "leaf": {
        "kind": "crud",
        "appBase": "pos",
        "icon": "fa-store",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "state": "Estado",
            "is_active": "Activa"
          }
        }
      }
    },
    {
      "id": "pos.pos-order",
      "path": "pos-order",
      "permission": "subject.pos.pos-order.read",
      "leaf": {
        "kind": "crud",
        "appBase": "pos-order",
        "icon": "fa-basket-shopping",
        "listHeaders": {
          "es": {
            "reference": "Referencia",
            "partner_name": "Nombre",
            "partner_lastname": "Apellido",
            "date_order": "Fecha",
            "amount_total": "Total"
          }
        },
        "formLabels": {
          "es": {
            "reference": "Referencia",
            "partner_id": "Cliente (id)",
            "partner_name": "Nombre del cliente",
            "partner_lastname": "Apellido del cliente",
            "partner_home": "Domicilio del cliente",
            "date_order": "Fecha de la orden",
            "amount_total": "Total",
            "lines": "Líneas",
            "sync": "Sincronizada",
            "product_id": "Producto (id)",
            "product": "Producto",
            "price_unit": "Precio unitario",
            "quantity": "Cantidad",
            "sale_order_id": "Pedido de venta (id)"
          }
        }
      }
    },
    {
      "id": "pos.pos-tickets",
      "path": "pos-tickets",
      "permission": "subject.pos.pos-tickets.read",
      "leaf": {
        "kind": "crud",
        "appBase": "pos-tickets",
        "icon": "fa-ticket",
        "listHeaders": {
          "es": {
            "name": "Nombre",
            "state": "Estado",
            "is_active": "Activa"
          }
        }
      }
    }
  ],
  "storage": {
    "domain": "shared-nox-postgres",
    "files": false
  },
  "resources": {
    "pos-session": "pos-session",
    "pos": "pos",
    "pos-order": "pos-order",
    "pos-tickets": "pos-tickets"
  },
  "dependsOn": [
    "subject-almacen",
    "subject-rh"
  ]
}
